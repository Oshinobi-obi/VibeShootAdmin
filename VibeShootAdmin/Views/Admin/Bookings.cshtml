@model VibeShootAdmin.Models.Admin.BookingsViewModel
@using VibeShootAdmin.Models.Entities
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Bookings";
    ViewData["Nav"] = "Bookings";
    ViewData["Subtitle"] = "Every booking request, its schedule and payment progress";
    var f = Model.Filter;
    var allCount = Model.StatusCounts.Values.Sum();

    string TabUrl(string? status)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(status)) parts.Add("status=" + Uri.EscapeDataString(status));
        if (f.PhotographerId != null) parts.Add("photographerId=" + f.PhotographerId);
        if (!string.IsNullOrEmpty(f.Q)) parts.Add("q=" + Uri.EscapeDataString(f.Q));
        if (f.From != null) parts.Add("from=" + f.From.Value.ToString("yyyy-MM-dd"));
        if (f.To != null) parts.Add("to=" + f.To.Value.ToString("yyyy-MM-dd"));
        return "?" + string.Join("&", parts);
    }
}

<div class="tabs">
    <a class="@(string.IsNullOrEmpty(f.Status) ? "active" : "")" href="@TabUrl(null)">All <span>@allCount</span></a>
    @foreach (var s in BookingStatus.All)
    {
        <a class="@(f.Status == s ? "active" : "")" href="@TabUrl(s)">@s <span>@(Model.StatusCounts.TryGetValue(s, out var c) ? c : 0)</span></a>
    }
</div>

<div class="card">
    <form class="filters" method="get">
        <input type="hidden" name="status" value="@f.Status" />
        @if (f.PhotographerId != null) { <input type="hidden" name="photographerId" value="@f.PhotographerId" /> }
        <div class="search">
            <svg><use href="#i-search" /></svg>
            <input class="adm-input" name="q" value="@f.Q" placeholder="Search client, transaction ID, mobile or venue" />
        </div>
        <label class="date">Shoot date <input class="adm-input" type="date" name="from" value="@f.From?.ToString("yyyy-MM-dd")" /></label>
        <label class="date">to <input class="adm-input" type="date" name="to" value="@f.To?.ToString("yyyy-MM-dd")" /></label>
        <button class="btn" type="submit">Filter</button>
        @if (!string.IsNullOrEmpty(f.Q) || f.From != null || f.To != null)
        {
            <a class="btn btn-ghost" href="?status=@Uri.EscapeDataString(f.Status ?? "")@(f.PhotographerId != null ? "&photographerId=" + f.PhotographerId : "")">Clear</a>
        }
    </form>

    @if (!Model.Items.Any())
    {
        <div class="empty"><svg><use href="#i-book" /></svg><b>No bookings found</b>Try a different filter or search.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="tbl">
                <thead>
                    <tr>
                        <th>Client</th>
                        <th>Shoot date</th>
                        <th>Package</th>
                        <th class="right">Total</th>
                        <th>Payment</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Items)
                    {
                        var paidPct = b.TotalPrice > 0 ? (int)Math.Min(100, b.AmountPaid / b.TotalPrice * 100) : 0;
                        <tr class="@(b.Status == BookingStatus.Pending ? "row-attn" : "")">
                            <td class="who">
                                <b>@b.ClientName</b>
                                <small class="mono">@b.TransactionId</small>
                                @if (ViewBag.IsSuperAdmin == true && f.PhotographerId == null) { <small> · @b.Photographer?.Name</small> }
                            </td>
                            <td class="nowrap">@b.TargetDate.ToString("ddd, MMM d, yyyy")<br /><small class="muted">@b.TimeRange</small></td>
                            <td>@b.Category<br /><small class="muted">@b.PackageName</small></td>
                            <td class="right num nowrap">@(b.TotalPrice > 0 ? Ui.Peso(b.TotalPrice) : "Quote")</td>
                            <td style="min-width:140px;">
                                @Ui.Pill(b.PaymentState)
                                @if (b.TotalPrice > 0)
                                {
                                    <div class="progress" style="margin:6px 0 0;height:5px;" title="@paidPct% paid"><div style="width:@paidPct%"></div></div>
                                }
                            </td>
                            <td>@Ui.Pill(b.Status)</td>
                            <td class="right"><a class="btn btn-sm" href="@Url.Action("BookingDetails", "Admin", new { id = b.TransactionId })">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <partial name="_Pager" model="(f.Page, Model.TotalPages, Model.TotalItems)" />
</div>
