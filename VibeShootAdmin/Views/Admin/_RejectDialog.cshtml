@model string
<dialog class="adm-dialog" id="rejectDialog">
    <form autocomplete="off" method="post" action="@Url.Action("RejectPayment", "Admin")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" />
        <input type="hidden" name="returnUrl" value="@Model" />
        <h3>Reject payment?</h3>
        <p data-reject-label></p>
        <div class="form-row">
            <label for="rejectRemarks">Reason (shown to the client)</label>
            <textarea autocomplete="off" class="adm-textarea" id="rejectRemarks" name="remarks" placeholder="e.g. Reference number not found in GCash history / amount does not match"></textarea>
        </div>
        <div class="dialog-actions">
            <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
            <button type="submit" class="btn btn-red">Reject payment</button>
        </div>
    </form>
</dialog>
